[Unit]
Description=Zhaohui HTTPS & Certificate External Probe (Dashboard Only, No External Alerting)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=zhaohui-admin
Group=zhaohui-admin
WorkingDirectory=/opt/zhaohui-admin/admin-platform
EnvironmentFile=/etc/zhaohui-admin/admin.env
ExecStart=/opt/zhaohui-admin/admin-platform/.venv/bin/python manage.py run_probes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zhaohui-admin

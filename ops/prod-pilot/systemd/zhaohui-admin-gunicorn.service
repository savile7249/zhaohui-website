[Unit]
Description=Zhaohui Multisite Monitor & Admin Platform (Gunicorn)
After=network-online.target mariadb.service
Wants=network-online.target
Requires=mariadb.service

[Service]
Type=simple
User=zhaohui-admin
Group=zhaohui-admin
WorkingDirectory=/opt/zhaohui-admin/admin-platform
EnvironmentFile=/etc/zhaohui-admin/admin.env
ExecStart=/opt/zhaohui-admin/admin-platform/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:18000 \
    --workers 2 \
    --threads 4 \
    --timeout 60 \
    --graceful-timeout 30 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zhaohui-admin /var/www/jszhff.cn /var/backups/zhaohui-admin

[Install]
WantedBy=multi-user.target

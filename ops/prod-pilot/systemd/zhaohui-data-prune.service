[Unit]
Description=Zhaohui Data Retention Cleanup (180d events / 365d audit logs)
After=mariadb.service
Requires=mariadb.service

[Service]
Type=oneshot
User=zhaohui-admin
Group=zhaohui-admin
WorkingDirectory=/opt/zhaohui-admin/admin-platform
EnvironmentFile=/etc/zhaohui-admin/admin.env
ExecStart=/opt/zhaohui-admin/admin-platform/.venv/bin/python manage.py prune_old_data --events-days 180 --audit-days 365
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zhaohui-admin

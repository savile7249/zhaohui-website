# ==============================================================================
# 兆辉多域名网站监测与管理后台 — 生产试点环境配置模板 (jszhff.cn)
# ------------------------------------------------------------------------------
# 部署路径建议：/etc/zhaohui-admin/admin.env  (chmod 600, chown root:zhaohui-admin)
# 严禁将包含真实密钥/密码的文件提交至 Git 仓库！
#
# 强随机密钥生成参考命令（在源站本机执行）：
#   DJANGO_SECRET_KEY     : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   ZHAOHUI_GATEWAY_SECRET: openssl rand -hex 32
#   ZHAOHUI_DB_PASSWORD   : python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# ==============================================================================

# --- 运行模式与安全基线 ---
ZHAOHUI_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=__REPLACE_WITH_MIN_48_CHAR_RANDOM_SECRET__

# 独立管理后台子域名（如改为其他子域请同步修改 nginx-admin-subdomain.conf）
DJANGO_ALLOWED_HOSTS=admin.jszhff.cn,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://admin.jszhff.cn

# HTTPS Cookie 安全属性（Nginx 终结 TLS 并传递 X-Forwarded-Proto: https）
# 认证策略：仅账号 + 强密码登录；无验证码（CAPTCHA）、无双向认证（mTLS）、无硬性 IP 白名单
ZHAOHUI_SECURE_HTTPS=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_SSL_REDIRECT=0
ZHAOHUI_SESSION_COOKIE_AGE=14400

# --- 源站 MariaDB 10.11.14 独立隔离库（严禁触碰既有 zhaohui_site） ---
ZHAOHUI_DB_NAME=zhaohui_admin
ZHAOHUI_DB_USER=zhaohui_admin_app
ZHAOHUI_DB_PASSWORD=__REPLACE_WITH_STRONG_DB_PASSWORD__
ZHAOHUI_DB_HOST=127.0.0.1
ZHAOHUI_DB_PORT=3306
ZHAOHUI_DB_CONN_MAX_AGE=60

# --- 目录与静态发布路径（精准匹配源站 /var/www/jszhff.cn 现状） ---
ZHAOHUI_RUNTIME_DIR=/var/lib/zhaohui-admin
ZHAOHUI_STATIC_ROOT=/var/lib/zhaohui-admin/django-static
ZHAOHUI_SITES_ROOT=/var/www
ZHAOHUI_SNAPSHOTS_ROOT=/var/lib/zhaohui-admin/snapshots
ZHAOHUI_BACKUPS_ROOT=/var/backups/zhaohui-admin
ZHAOHUI_USE_OFFICIAL_DOMAIN_PATHS=1

# 严禁在 2 vCPU 源站本机运行 next build，静态构建固定在本地开发机或 CI 完成
ZHAOHUI_ALLOW_ON_SERVER_BUILD=0

# --- 本机可信网关签名凭据（event_forwarder 与 nginx_log_aggregator 共用） ---
ZHAOHUI_GATEWAY_ID=prod-zhaohui-nginx-01
ZHAOHUI_GATEWAY_SECRET=__REPLACE_WITH_64_HEX_GATEWAY_SECRET__
ZHAOHUI_ALLOWED_DOMAINS=jszhff.cn
ZHAOHUI_BACKEND_URL=http://127.0.0.1:18000
ZHAOHUI_FORWARDER_PORT=18081

# Nginx 分域名结构化指标日志与心跳容忍窗口（汇聚定时器每 60s 执行，180s = 3 次容错）
ZHAOHUI_METRICS_LOG_PATH=/var/log/nginx/jszhff.cn.metrics.log
ZHAOHUI_AGGREGATOR_STATE_FILE=/var/lib/zhaohui-admin/log-aggregator-state.json
ZHAOHUI_HEARTBEAT_STALE_SECONDS=180

# --- 外部探测配置（仅写入后台总览与故障恢复记录，不发外部通知） ---
ZHAOHUI_PROBE_USE_OFFICIAL_DOMAIN=1
# 留空表示按 DNS 正常探测公网 https://jszhff.cn/；若需本机回环校验 SNI 可填 127.0.0.1
ZHAOHUI_PROBE_TARGET_HOST=
ZHAOHUI_PROBE_TARGET_PORT=443
# 留空使用系统根证书库校验 Let's Encrypt 正式证书
ZHAOHUI_CA_CERT_PATH=
ZHAOHUI_CERT_WARNING_DAYS=14

# --- 数据保留策略（用户已确认默认推荐：事件明细 180 天、审计日志 365 天） ---
ZHAOHUI_DATA_RETENTION_EVENTS_DAYS=180
ZHAOHUI_DATA_RETENTION_AUDIT_DAYS=365
